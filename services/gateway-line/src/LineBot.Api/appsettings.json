{
  "Runtime": { "Platform": "Local" },
  "ContractVersion": "0.1",
  "App": { "BaseUrl": "http://localhost:8080" },
  "Chat": {
    "RequestTimeoutSeconds": 20,
    "Http": {
      "BaseUrl": "",
      "EndpointTemplate": "/chat/{version}/generate-replies",
      "VersionHeaderName": "X-Chat-Api-Version",
      "AdditionalHeaders": {}
    }
  },
  "Contracts": {
    "C0_1": {
      "Chat": {
        "AuthorUserIdPrefix": "line-",
        "Fallbacks": {
          "Default": "The service is temporarily unavailable.",
          "Timeout": "The request timed out. Please try again."
        }
      }
    }
  },
  "ConnectionManagement": {
    "Http": {
      "BaseUrl": "",
      "GetConnection": { "EndpointTemplate": "/channel/{version}/get-connection" },
      "ResolveActor": { "EndpointTemplate": "/channel/{version}/resolve-actor" }
    }
  },
  "Local": { "Queue": { "MaxSize": 15 } },
  "Reply": {
    "QueueMaxSize": 15,
    "QueueFullMessages": [
      "Sorry, I'm a bit busy. Please try again in a moment.",
      "System is crowded now. Try again shortly."
    ]
  },
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*"
}
